{
  "name": "bondhu-fund-desktop",
  "version": "2.8.0",
  "description": "Bondhu Fund - offline fund management for member savings groups",
  "author": "Bondhu Fund",
  "homepage": "https://www.iqballabs.com",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json --noEmit && node scripts/bundle-electron.js",
    "build:all": "npm run build && npm run build:electron",
    "dist": "npm run build:all && electron-builder --win nsis portable zip --x64",
    "dist:dir": "npm run build:all && electron-builder --win --dir",
    "dist:mac": "npm run build:all && electron-builder --mac dmg zip --arm64",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development ELECTRON_RUN_AS_NODE= electron .\"",
    "start": "cmd /c \"set ELECTRON_RUN_AS_NODE=&& node_modules\\electron\\dist\\electron.exe .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test:db": "node scripts/bundle-electron.js && node scripts/db-test.js",
    "screenshots": "npm run build:all && cross-env ELECTRON_RUN_AS_NODE= electron scripts/capture-screenshots.js",
    "test:settle": "node scripts/bundle-electron.js && node scripts/settle-test.js",
    "test:import": "node scripts/bundle-electron.js && node scripts/import-test.js",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "test:audit": "node scripts/bundle-electron.js && node scripts/audit-test.js",
    "test:backup": "node scripts/bundle-electron.js && node scripts/backup-test.js",
    "test:nid": "node scripts/bundle-electron.js && node scripts/nid-test.js",
    "test:loans": "node scripts/bundle-electron.js && node scripts/loan-test.js",
    "test:access": "node scripts/bundle-electron.js && node scripts/access-test.js",
    "test:gsync": "node scripts/bundle-electron.js && node scripts/gsync-test.js",
    "test:license": "node scripts/bundle-electron.js && node scripts/license-test.js",
    "test:review": "node scripts/bundle-electron.js && node scripts/review-test.js",
    "test:fines": "node scripts/bundle-electron.js && node scripts/fines-test.js",
    "test:fuzz": "node scripts/bundle-electron.js && node scripts/books-fuzz-test.js"
  },
  "build": {
    "appId": "org.bondhufund.desktop",
    "productName": "Bondhu Fund",
    "copyright": "Copyright (c) 2026 Iqbal Labs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist-electron/**/*.map",
      "!dist/sql-wasm.wasm",
      "build/icon.ico",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "artifactName": "BondhuFund-Windows-${version}.${ext}",
      "signtoolOptions": {
        "publisherName": [
          "Iqbal Labs"
        ],
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "mac": {
      "icon": "build/icon-mac.png",
      "category": "public.app-category.finance",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "identity": null,
      "artifactName": "BondhuFund-macOS-${version}-${arch}.${ext}"
    },
    "dmg": { "title": "Bondhu Fund ${version}" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Bondhu Fund",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "BondhuFund-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "BondhuFund-Portable-${version}.exe"
    },
    "electronVersion": "35.7.5",
    "electronLanguages": [
      "en-US",
      "bn"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/noto-sans-bengali": "^5.1.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "echarts": "^5.5.1",
    "electron": "35.7.5",
    "electron-builder": "^26.18.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.16.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "sql.js": "^1.12.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
